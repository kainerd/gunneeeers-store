# Root hardening — deny listing, block sensitive extensions, set security headers.
# Apache / XAMPP (mod_rewrite, mod_headers, mod_authz_core assumed available).

Options -Indexes

# Block direct access to dotfiles (e.g. .env, .git) — path traversal / secret leakage.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

# Block backup / dump / log files that must never be served.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(env|sql|log|bak|swp|old|dist|ini|config)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # CSP is also set in PHP (security.php) so non-Apache hosts still get it;
  # keeping a baseline here as defense-in-depth for static assets.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Deny direct web access to protected application folders.
# (Each folder also has its own .htaccess — belt and suspenders.)
# Note: setup/ is intentionally NOT blocked here — generate-admin.php must be
# reachable once, then the whole setup/ folder should be deleted from the server.
RedirectMatch 403 (?i)^/(config|includes|sql)/
