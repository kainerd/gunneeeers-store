# Server
PORT=3000
NODE_ENV=development

# MySQL — prefer a single URL
# Railway (web service): MYSQL_URL=${{ MySQL.MYSQL_URL }}
# Railway fallback:
# MYSQL_URL=mysql://${{ MySQL.MYSQLUSER }}:${{ MySQL.MYSQLPASSWORD }}@${{ MySQL.MYSQLHOST }}:${{ MySQL.MYSQLPORT }}/${{ MySQL.MYSQLDATABASE }}
# Local: MYSQL_URL=mysql://user:pass@127.0.0.1:3306/gunneeeers_store
MYSQL_URL=

# Or discrete vars (local XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gunneeeers_store
DB_USER=store_app
DB_PASS=CHANGE_ME_DB_PASSWORD

# JWT — use a long random secret in production (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# Store contact (public)
STORE_NAME=Gunneeeers Store
STORE_WHATSAPP=249112780717
STORE_EMAIL=emadsesko@gmail.com

# Set true ONLY to create the first admin, then set false again
SETUP_ENABLED=false
