# Paste into Railway → your Node/web service → Variables
# If your MySQL service is NOT named "MySQL", change every "MySQL" below to that exact name.

# --- required ---
MYSQL_URL=${{ MySQL.MYSQL_URL }}
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_OUTPUT
NODE_ENV=production
SETUP_ENABLED=false

